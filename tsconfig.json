{
  // Type check for everything that runs in the browser (src/ui, src/pages) and for all tests.
  // Model code is checked a second time WITHOUT browser types by src/models/tsconfig.json.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"]
  },
  "include": ["src"],
  "exclude": ["src/models/_rule4-guard.ts"]
}
